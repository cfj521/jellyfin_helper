# ============================================================
# jellyfin-helper Docker Compose 环境变量
# 复制为 .env 后改值。带 ?? 注释的是「必填」字段，没填 compose 不会启动。
# ============================================================

# ── 通用 ───────────────────────────────────────────────────
PUID=1000                       # 宿主你想用的 uid（id -u 查），影响落盘文件属主
PGID=1000                       # 宿主你想用的 gid（id -g 查）
TZ=Asia/Shanghai                # 容器时区

# ── 外部目录（必填，没默认） ─────────────────────────────
# 媒体库根目录：jellyfin / helper 都会读它；建议只读挂载到 jellyfin
MEDIA_DIR=/CHANGE/ME/path/to/media
# 下载目录：qBittorrent 写、helper 读后组织入库
DOWNLOADS_DIR=/CHANGE/ME/path/to/downloads

# ── 端口（默认即可，端口冲突时改） ────────────────────────
HELPER_PORT=8099                # jellyfin-helper Web UI
JELLYFIN_PORT=8096              # Jellyfin Web UI
JACKETT_PORT=9117               # Jackett Web UI
QB_WEBUI_PORT=8080              # qBittorrent Web UI
QB_TORRENT_PORT=6881            # qBittorrent BT 端口（TCP + UDP）

# ── Postgres ─────────────────────────────────────────────
# 默认密码 = jellyfin_helper，bootstrap 会同步写进 config.yaml database.password。
# stack 内部使用，5432 不暴露宿主，外网无法访问 → 弱密码可接受。
# 如果你要对外暴露 5432（不推荐），务必改成强密码 + 同步 config.yaml。
POSTGRES_PASSWORD=jellyfin_helper
POSTGRES_USER=jellyfin_helper
POSTGRES_DB=jellyfin_helper
