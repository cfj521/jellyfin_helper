# Jellyfin Helper 配置文件示例
# 复制为 config.yaml 后填入你自己的值。
# config.yaml 已在 .gitignore 中排除，切勿提交到公开仓库。

# ============================================================================
# 认证
# ============================================================================
# secret_key 随机生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
# token_expire_hours：登录有效期，720 = 30 天
# users：账号列表，role 取 admin / guest
auth:
  secret_key: "change-me-to-a-random-string"
  token_expire_hours: 720
  users:
    # Docker：bootstrap 自动把 admin 密码设为 jellyfin_helper（这里若仍是 CHANGE_ME）
    - username: admin
      password: "CHANGE_ME"
      role: admin
    - username: guest
      password: "guest"
      role: guest

# ============================================================================
# 服务端口
# ============================================================================
server:
  backend_port: 8099
  frontend_port: 5173

# ============================================================================
# PostgreSQL
# ============================================================================
database:
  host: "127.0.0.1"
  port: 5432
  name: "jellyfin_helper"
  user: "jellyfin_helper"
  password: "CHANGE_ME"

# ============================================================================
# Jellyfin
# ============================================================================
# Docker：bootstrap 自动跑 Setup Wizard（admin/jellyfin_helper）+ 申请 API Key
# 裸机：Jellyfin Web → 控制台 → API Keys 新建后填入 api_key
jellyfin:
  host: "http://127.0.0.1:8096"
  # 公网访问地址（可选）：UI 生成跳转链接时优先用
  external_url: ""
  api_key: ""
  # 可选：jellyfin SQLite 直读加速（同机部署填 /var/lib/jellyfin/data/jellyfin.db）
  # 留空 → 全走 REST API
  db_path: ""

# ============================================================================
# TMDB（必填，https://www.themoviedb.org/settings/api 申请）
# ============================================================================
tmdb:
  api_key: ""
  language: "zh-CN"

# ============================================================================
# 路径映射（跨主机部署用；同机部署留 enabled: false）
# ============================================================================
path_mappings:
  enabled: false
  rules:
    # - { from: "/library/videos", to: "Z:/videos" }

# ============================================================================
# 系统工具路径（仅 Windows 需要，Linux/macOS 一般在 PATH 上）
# ============================================================================
tools:
  ffmpeg_dir: ""          # 例：Windows "C:/ffmpeg/bin"
  mkvtoolnix_dir: ""      # 例：Windows "C:/Program Files/MKVToolNix"

# ============================================================================
# 缓存 TTL（改动后重启后端生效）
# ============================================================================
cache:
  tmdb_minutes: 120
  library_days: 7

# ============================================================================
# Wikidata（演员图兜底，无需 Key；user_agent 改成你的联系方式或仓库 URL）
# ============================================================================
wikidata:
  enabled: true
  user_agent: "JellyfinHelper/1.0 (your_email@example.com)"
  language_order: ["zh", "en"]

# ============================================================================
# MDBList（评分聚合，https://mdblist.com/api 申请，免费 1000 req/天）
# ============================================================================
mdblist:
  enabled: true
  api_key: ""
  cache_ttl_days: 30

# ============================================================================
# 豆瓣评分（无需 Key；境外部署需走系统代理）
# ============================================================================
douban:
  enabled: true
  cache_ttl_days: 60
  user_agent: "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"

# ============================================================================
# 元数据存储
# ============================================================================
metadata:
  store_douban_full: true     # 豆瓣完整字段（简介/演员/标签）落库
  lru_keep_days: 365          # 长期未访问条目的 LRU 保留期
  refresh_ttl_days: 30        # 同条记录 N 天内不重新拉远端
  scrape_language: "en"       # 刮削语言
  display_language: "en"      # 前端默认显示语言

# ============================================================================
# 字幕
# ============================================================================
# OpenSubtitles：https://www.opensubtitles.com/consumers 申请 API Consumer
# ASSRT 射手：https://secure.assrt.net/usercp.php 注册账号拿 API Token
subtitle:
  # 判定"缺字幕"用：任一缺即视为缺。值域 chs / cht / eng / jpn / kor / zh（zh 同时覆盖简繁）
  required_langs: ["chs", "eng"]
  # 自动下载优先级，支持双语复合 chs.eng / cht.eng
  downloading_langs: ["chs.eng", "chs", "eng"]

  opensubtitles_api_key: ""
  opensubtitles_username: ""
  opensubtitles_password: ""
  assrt_api_token: ""

  # 下载源优先级，按顺序尝试，第一个命中即返回
  sources:
    - { name: shooter,       enabled: true }
    - { name: assrt,         enabled: true }
    - { name: opensubtitles, enabled: true }
  preferred_formats: ["srt", "ass", "ssa", "sub", "vtt"]

# ============================================================================
# 音轨（MKV 默认音轨偏好）
# ============================================================================
audio:
  preferred_langs: ["chs", "eng"]

# ============================================================================
# Jackett（种子搜索聚合）
# ============================================================================
# Docker：bootstrap 自动生成 api_key 并回写
# 裸机：Jackett UI 右上角直接显示 API Key
jackett:
  host: "http://127.0.0.1:9117"
  api_key: ""
  search_keywords: []
  default_keywords: ""

# ============================================================================
# qBittorrent（要求 5.2.0+，强制 API Key 认证）
# ============================================================================
# Docker：bootstrap 自动生成 api_key 并回写
# 裸机：qB → Preferences → WebUI → API Key 生成（qbt_ 开头 32 字符）
qbittorrent:
  host: "http://127.0.0.1:8080"
  api_key: ""

  # 配额：limit 动态读 dispatch.download_path 真实容量
  quota:
    enabled: true
    warn_threshold: 0.85          # 85% UI 提醒
    cleanup_threshold: 0.95       # 95% 触发硬清
    target_after_cleanup: 0.70    # 清回 70% 留余量
    check_interval_seconds: 300

  # 做种策略：状态停止 + (达到分享率 或 完成 N 天) 即可软清
  seeding:
    target_ratio: 1.0
    min_seed_days: 3
    min_seed_hours_per_torrent: 24
    cleanup_interval_seconds: 3600

# ============================================================================
# 下载入库流水线（完成后自动转移 + 字幕/音轨后处理）
# ============================================================================
# duplicate_policy 取值：
#   higher_quality_wins  - 新种子质量更高才覆盖（默认）
#   always_skip          - 永远保留旧的
#   always_replace       - 永远用新的
#   needs_review         - 标记待人工决策
dispatch:
  enabled: true
  download_path: "/downloads"
  poll_interval_seconds: 30
  adopt_interval_seconds: 300
  trash_interval_seconds: 86400
  worker_concurrency: 1
  trash_dir: "/downloads/.trash"
  default_move_mode: copy
  rules:
    movie:
      library_id: ""
      location_template: "{library_root}/{title} ({year})"
      file_template: "{title} ({year})"
      duplicate_policy: higher_quality_wins
    tv:
      library_id: ""
      location_template: "{library_root}/{series_name}/Season {season:02d}"
      file_template: "({series_name})S{season:02d}E{episode:02d}"
      duplicate_policy: higher_quality_wins
    anime:
      library_id: ""
      location_template: "{library_root}/{anime_name}"
      file_template: "({anime_name}){episode:03d}"
      duplicate_policy: higher_quality_wins
    adult:
      library_id: ""
      location_template: "{library_root}/{code}"
      file_template: "{code}({title})"
      duplicate_policy: always_skip

# ============================================================================
# LLM 媒体识别（可选，作为正则/TMDB 识别失败时的兜底）
# ============================================================================
llm:
  enabled: false
  provider: qwen                  # qwen / deepseek / openai / lmstudio
  api_key: ""
  model: qwen-plus
  base_url: "https://dashscope.aliyuncs.com/compatible-mode/v1"
  timeout_seconds: 180
  max_retries: 1
  cache_ttl_days: 30
  prefer_first: false             # true：LLM 排识别链首位

# ============================================================================
# Trakt（推荐源，https://trakt.tv/oauth/applications 创建 app 拿 client_id）
# ============================================================================
trakt:
  enabled: false
  client_id: ""
  base_url: "https://api.trakt.tv"
  cache_minutes: 60

# ============================================================================
# AniList（番剧推荐，无需 Key）
# ============================================================================
anilist:
  enabled: true
  base_url: "https://graphql.anilist.co"
  cache_minutes: 240

# ============================================================================
# 豆瓣片单
# ============================================================================
# doulist_id 取值：
#   纯数字       → /doulist/<id>/ 片单（如 Top 250 的 240962）
#   "chart"      → 豆瓣电影排行榜
#   "nowplaying" → 正在上映
#   "upcoming"   → 即将上映
douban_lists:
  enabled: true
  cache_days: 3
  lists:
    - { name: "豆瓣 Top 250", doulist_id: "240962",     media_type: "movie" }
    - { name: "豆瓣排行榜",   doulist_id: "chart",      media_type: "movie" }
    - { name: "正在上映",     doulist_id: "nowplaying", media_type: "movie" }
    - { name: "即将上映",     doulist_id: "upcoming",   media_type: "movie" }

# ============================================================================
# 成人内容（默认关闭；enabled=false 时菜单不显示）
# ============================================================================
adult:
  enabled: false
  media_path: ""
  library_ids: []               # 指定哪些 Jellyfin 库 ID 视为成人库；留空 → 自动检测
  extra_paths: []               # 额外的本地路径（不在 Jellyfin 库里的）
  auto_detect: true
  auto_scrape: false            # 新 item 入库后自动跑番号识别
  poll_interval_min: 120        # 扫描周期（最小 30 分钟）
  # 刮削源按顺序回退
  sources:
    - { name: javbus,     enabled: true }
    - { name: javdb,      enabled: true }
    - { name: javlibrary, enabled: false }
    - { name: avbase,     enabled: true }
    - { name: missav,     enabled: true }

# ============================================================================
# 调试
# ============================================================================
debug:
  show_dry_run_in_toolbar: false   # UI 操作弹窗显示「测试模式」勾选
